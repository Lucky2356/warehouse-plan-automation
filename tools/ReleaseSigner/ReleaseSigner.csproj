<Project Sdk="Microsoft.NET.Sdk">

  <!--
    Подпись выпусков. В решение не входит и в релиз не попадает: запускается на компьютере
    разработчика, где в хранилище ключей Windows лежит закрытый ключ.
  -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>ReleaseSigner</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\WarehousePlanAutomation.Core\WarehousePlanAutomation.Core.csproj" />
  </ItemGroup>

</Project>

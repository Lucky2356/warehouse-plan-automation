<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        Тёмная тема. Ключи те же, что в светлой, - меняются только цвета.

        Поле, карточка и панель разведены по светлоте заметно: на тёмном фоне разница
        в пару единиц просто не видна, и карточка сливается с полем. Панель темнее поля,
        а не светлее - светлая полоса сбоку на тёмном выглядела бы наклейкой.

        Смысловые цвета взяты светлее и приглушённее: насыщенный зелёный и оранжевый
        из светлой темы на тёмном выжигают глаза, а тёмно-красный не читается вовсе.
    -->

    <SolidColorBrush x:Key="GroundBrush" Color="#191A22" />
    <SolidColorBrush x:Key="CardBrush" Color="#23242F" />
    <SolidColorBrush x:Key="CardBorderBrush" Color="#383A49" />
    <SolidColorBrush x:Key="HairlineBrush" Color="#31323F" />
    <SolidColorBrush x:Key="TileBrush" Color="#2C2D3A" />
    <SolidColorBrush x:Key="InputBrush" Color="#1B1C25" />
    <SolidColorBrush x:Key="InputBorderBrush" Color="#414354" />
    <SolidColorBrush x:Key="OnAccentBrush" Color="#FFFFFF" />

    <SolidColorBrush x:Key="InkBrush" Color="#EDEDF2" />
    <SolidColorBrush x:Key="InkSecondaryBrush" Color="#BEBFCB" />
    <SolidColorBrush x:Key="InkMutedBrush" Color="#9C9DAB" />
    <SolidColorBrush x:Key="InkFaintBrush" Color="#82838F" />

    <SolidColorBrush x:Key="AccentBrush" Color="#7276DC" />
    <SolidColorBrush x:Key="AccentHoverBrush" Color="#8387E8" />
    <SolidColorBrush x:Key="AccentPressedBrush" Color="#6A6ED2" />
    <SolidColorBrush x:Key="AccentDisabledBrush" Color="#3E4056" />
    <SolidColorBrush x:Key="AccentSoftBrush" Color="#2C2E48" />
    <SolidColorBrush x:Key="TrackBrush" Color="#383A4B" />

    <SolidColorBrush x:Key="ButtonBorderBrush" Color="#474959" />
    <SolidColorBrush x:Key="ButtonHoverBrush" Color="#2E2F3D" />
    <SolidColorBrush x:Key="ButtonPressedBrush" Color="#373948" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush" Color="#1F202A" />
    <SolidColorBrush x:Key="FocusRingBrush" Color="#EDEDF2" />

    <SolidColorBrush x:Key="ScrollThumbBrush" Color="#4A4C5E" />
    <SolidColorBrush x:Key="ScrollThumbHoverBrush" Color="#646677" />

    <SolidColorBrush x:Key="NavBrush" Color="#101119" />
    <SolidColorBrush x:Key="NavBorderBrush" Color="#080910" />
    <SolidColorBrush x:Key="NavHoverBrush" Color="#1D1E29" />
    <SolidColorBrush x:Key="NavSelectedBrush" Color="#2A2C3C" />
    <SolidColorBrush x:Key="NavAccentBrush" Color="#9195EC" />
    <SolidColorBrush x:Key="NavMarkBrush" Color="#7276DC" />
    <SolidColorBrush x:Key="NavInkBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="NavInkSecondaryBrush" Color="#B6B7C4" />
    <SolidColorBrush x:Key="NavInkFaintBrush" Color="#787987" />

    <SolidColorBrush x:Key="SuccessBrush" Color="#78CE95" />
    <SolidColorBrush x:Key="SuccessSoftBrush" Color="#1E3229" />
    <SolidColorBrush x:Key="SuccessBorderBrush" Color="#37543F" />
    <SolidColorBrush x:Key="SuccessStripBrush" Color="#1D2A2A" />

    <SolidColorBrush x:Key="WarnBrush" Color="#E8B06A" />
    <SolidColorBrush x:Key="WarnInkBrush" Color="#EFC98C" />
    <SolidColorBrush x:Key="WarnSoftBrush" Color="#332A1E" />
    <SolidColorBrush x:Key="WarnBorderBrush" Color="#5A4526" />

    <SolidColorBrush x:Key="ErrorBrush" Color="#EF8B82" />
    <SolidColorBrush x:Key="ErrorSoftBrush" Color="#32221F" />
    <SolidColorBrush x:Key="ErrorBorderBrush" Color="#573531" />

</ResourceDictionary>

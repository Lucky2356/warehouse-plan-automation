<Application x:Class="WarehousePlanAutomation.App.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>

            <!--
                Палитра лежит отдельными словарями и подменяется на ходу, поэтому
                все ссылки на кисти ниже - DynamicResource: StaticResource запомнил бы
                цвет один раз, и переключение темы ничего бы не изменило.
                Тема при запуске выбирается в App.xaml.cs, здесь стоит светлая -
                чтобы окно рисовалось и в конструкторе, и в харнессе снимков.
            -->
            <ResourceDictionary.MergedDictionaries>
                <ResourceDictionary Source="Themes/Light.xaml" />
            </ResourceDictionary.MergedDictionaries>

                <!-- Типографика -->
            <!--
                Цвет здесь намеренно не задаётся. Надпись на кнопке рисует тот же
                TextBlock, и заданный тут цвет перебил бы белый цвет кнопки-акцента:
                значение из стиля сильнее унаследованного. Обычный текст получает
                цвет по наследству - Foreground задан у окна и у экранов.
            -->
            <Style TargetType="TextBlock">
                <!--
                    Начертание Medium, а не Regular: окно читают весь день, и на светлом
                    поле обычный вес Segoe UI выглядит бледным. Там, где Medium в шрифте
                    нет, система сама подставит ближайший - вид не поедет.
                -->
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
            </Style>

            <Style x:Key="TitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="22" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="SubtitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Надпись над карточкой: «ИСХОДНАЯ КНИГА» -->
            <Style x:Key="SectionLabelText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="CaptionText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="Foreground" Value="{DynamicResource InkMutedBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!--
                Крупная цифра счётчика. Табличные цифры одной ширины: иначе соседние плитки
                в ряду выглядят разъехавшимися - «111» заметно уже «388».
            -->
            <Style x:Key="CounterText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="25" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <!-- Карточка -->
            <Style x:Key="Card" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource CardBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="10" />
                <Setter Property="Padding" Value="16,15" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="Tile" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource TileBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="11,10" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <!-- Метка состояния: «Распред собран» рядом с заголовком -->
            <Style x:Key="Pill" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource SuccessSoftBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SuccessBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="CornerRadius" Value="999" />
                <Setter Property="Padding" Value="10,4" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="PillText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="12" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource SuccessBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- Счётчик замечаний рядом с подписью раздела -->
            <Style x:Key="CountBadge" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="CountBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
                <Setter Property="Typography.NumeralAlignment" Value="Tabular" />
            </Style>

            <!-- Кнопка-акцент -->
            <Style x:Key="PrimaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Padding" Value="22,0" />
                <Setter Property="Height" Value="38" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource AccentHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource AccentPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource FocusRingBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <!--
                                    Выключенная кнопка остаётся акцентной, только бледной:
                                    она и в этом виде - главная кнопка экрана. Надпись
                                    при этом тёмная, а не белая: белым по бледному
                                    акценту её не прочитать.
                                -->
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource AccentDisabledBrush}" />
                                    <Setter Property="Foreground"
                                            Value="{DynamicResource InkSecondaryBrush}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Обычная кнопка -->
            <Style x:Key="SecondaryButton" TargetType="Button">
                <Setter Property="Background" Value="{DynamicResource CardBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="FontSize" Value="13.5" />
                <Setter Property="FontWeight" Value="Medium" />
                <Setter Property="Padding" Value="16,0" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource ButtonBorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"
                                                  Margin="{TemplateBinding Padding}" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource ButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource ButtonPressedBrush}" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="Chrome" Property="BorderBrush"
                                            Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Chrome" Property="BorderThickness" Value="2" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource DisabledSurfaceBrush}" />
                                    <Setter Property="Foreground" Value="{DynamicResource InkFaintBrush}" />
                                    <Setter Property="Cursor" Value="Arrow" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Поле с путём к файлу: только для чтения, но текст можно выделить и скопировать -->
            <Style x:Key="PathTextBox" TargetType="TextBox">
                <Setter Property="IsReadOnly" Value="True" />
                <Setter Property="Height" Value="36" />
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Padding" Value="12,0" />
                <Setter Property="VerticalContentAlignment" Value="Center" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="TextBox">
                            <Border x:Name="Chrome"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Margin="{TemplateBinding Padding}"
                                              VerticalAlignment="Center" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- Полоса прогресса: 5 px, скруглённая -->
            <Style x:Key="SlimProgressBar" TargetType="ProgressBar">
                <Setter Property="Height" Value="5" />
                <Setter Property="Minimum" Value="0" />
                <Setter Property="Maximum" Value="100" />
                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                <Setter Property="Background" Value="{DynamicResource TrackBrush}" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ProgressBar">
                            <Border Background="{TemplateBinding Background}"
                                    CornerRadius="3"
                                    ClipToBounds="True"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <Rectangle x:Name="PART_Track" />
                                    <Rectangle x:Name="PART_Indicator"
                                               HorizontalAlignment="Left"
                                               RadiusX="3" RadiusY="3"
                                               Fill="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!--
                Полоса прокрутки. Своя нужна ради одного: стандартная в WPF рисуется
                широкой серой лентой со стрелками и в спокойном светлом окне выглядит
                чужой. Здесь она узкая, без стрелок и без фона.
            -->
            <Style x:Key="SlimScrollThumb" TargetType="Thumb">
                <Setter Property="IsTabStop" Value="False" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Thumb">
                            <Border x:Name="Chrome"
                                    Background="{DynamicResource ScrollThumbBrush}"
                                    CornerRadius="3"
                                    Margin="2,0"
                                    SnapsToDevicePixels="True" />
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource ScrollThumbHoverBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style TargetType="ScrollBar">
                <Setter Property="Width" Value="10" />
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.Thumb>
                                    <Thumb Style="{StaticResource SlimScrollThumb}" />
                                </Track.Thumb>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0" IsTabStop="False" />
                                </Track.IncreaseRepeatButton>
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0" IsTabStop="False" />
                                </Track.DecreaseRepeatButton>
                            </Track>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
                <Style.Triggers>
                    <Trigger Property="Orientation" Value="Horizontal">
                        <Setter Property="Width" Value="Auto" />
                        <Setter Property="Height" Value="10" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ScrollBar">
                                    <Track x:Name="PART_Track" IsDirectionReversed="False">
                                        <Track.Thumb>
                                            <Thumb Style="{StaticResource SlimScrollThumb}" />
                                        </Track.Thumb>
                                        <Track.IncreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageRightCommand" Opacity="0" IsTabStop="False" />
                                        </Track.IncreaseRepeatButton>
                                        <Track.DecreaseRepeatButton>
                                            <RepeatButton Command="ScrollBar.PageLeftCommand" Opacity="0" IsTabStop="False" />
                                        </Track.DecreaseRepeatButton>
                                    </Track>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Trigger>
                </Style.Triggers>
            </Style>

            <!--
                Пункт боковой панели. Выбранный получает белую подложку и полоску акцента
                слева: одного цвета текста мало, чтобы понять, где ты находишься.
            -->
            <Style x:Key="NavItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="10,1" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Grid>
                                <Border x:Name="Chrome"
                                        Background="Transparent"
                                        CornerRadius="7"
                                        SnapsToDevicePixels="True">
                                    <ContentPresenter Margin="12,9" VerticalAlignment="Center" />
                                </Border>
                                <Border x:Name="Marker"
                                        Width="3"
                                        Margin="0,8"
                                        HorizontalAlignment="Left"
                                        CornerRadius="0,2,2,0"
                                        Background="Transparent"
                                        SnapsToDevicePixels="True" />
                            </Grid>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource NavHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource NavSelectedBrush}" />
                                    <Setter TargetName="Marker" Property="Background"
                                            Value="{DynamicResource NavAccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavList" TargetType="ListBox">
                <Setter Property="Background" Value="Transparent" />
                <Setter Property="BorderThickness" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource NavItem}" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            </Style>

            <!--
                Вариант ответа в окне выбора. Свой шаблон нужен потому, что обычный
                ListBoxItem красит выбранную строку системным синим и системным цветом
                текста - мимо темы приложения и почти нечитаемо на тёмном фоне.

                Выбранный вариант виден тремя признаками сразу: кружок слева закрашен,
                подложка светлее, текст ярче. Одного цвета мало.
            -->
            <Style x:Key="OptionItem" TargetType="ListBoxItem">
                <Setter Property="Padding" Value="0" />
                <Setter Property="Margin" Value="0" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    BorderBrush="Transparent"
                                    BorderThickness="0,0,0,1"
                                    SnapsToDevicePixels="True">
                                <Grid Margin="14,11">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid Grid.Column="0" Width="16" Height="16" Margin="0,1,12,0"
                                          VerticalAlignment="Top">
                                        <Ellipse x:Name="Ring"
                                                 Stroke="{DynamicResource InkFaintBrush}"
                                                 StrokeThickness="1.5" />
                                        <Ellipse x:Name="Dot"
                                                 Width="8"
                                                 Height="8"
                                                 Fill="Transparent" />
                                    </Grid>

                                    <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource ButtonHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsSelected" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource AccentSoftBrush}" />
                                    <Setter TargetName="Ring" Property="Stroke"
                                            Value="{DynamicResource AccentBrush}" />
                                    <Setter TargetName="Dot" Property="Fill"
                                            Value="{DynamicResource AccentBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="OptionList" TargetType="ListBox">
                <Setter Property="Background" Value="{DynamicResource InputBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource InputBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Padding" Value="0" />
                <Setter Property="ItemContainerStyle" Value="{StaticResource OptionItem}" />
                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
                <Setter Property="KeyboardNavigation.DirectionalNavigation" Value="Cycle" />
            </Style>

            <Style x:Key="OptionText" TargetType="TextBlock">
                <Setter Property="Foreground" Value="{DynamicResource InkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                 Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Длинное название («Приемка на хранилище · подготовка») переносится на вторую
                строку, а не обрезается многоточием: иначе его не отличить от просто «Приемки».
            -->
            <Style x:Key="NavItemText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="Foreground" Value="{DynamicResource NavInkSecondaryBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
                <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                 Value="True">
                        <Setter Property="Foreground" Value="{DynamicResource NavInkBrush}" />
                        <Setter Property="FontWeight" Value="SemiBold" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- Значок задачи. Цвет тот же, что у подписи: значок читается вместе с ней. -->
            <Style x:Key="NavItemIcon" TargetType="Path">
                <!--
                    Размер задан рисунком, а не растяжением: у значков разные габариты,
                    и Stretch подгонял бы каждый по-своему - толщина линий поехала бы.
                -->
                <Setter Property="Width" Value="20" />
                <Setter Property="Height" Value="20" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="Stroke" Value="{DynamicResource NavInkSecondaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.6" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource NavAccentBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!--
                Значок у пункта панели: «новое» рядом с «Обновлениями». Цвет акцентный:
                это не предупреждение, а хорошая новость.
            -->
            <Style x:Key="NavBadge" TargetType="Border">
                <Setter Property="Background" Value="{DynamicResource NavMarkBrush}" />
                <Setter Property="CornerRadius" Value="8" />
                <Setter Property="Padding" Value="7,2" />
                <Setter Property="Margin" Value="8,0,0,0" />
                <Setter Property="VerticalAlignment" Value="Center" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
            </Style>

            <Style x:Key="NavBadgeText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="10" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource OnAccentBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <!-- Та же новость на свёрнутой панели, где подписи нет: точка над значком -->
            <Style x:Key="NavBadgeDot" TargetType="Ellipse">
                <Setter Property="Width" Value="7" />
                <Setter Property="Height" Value="7" />
                <Setter Property="Fill" Value="{DynamicResource NavMarkBrush}" />
                <Setter Property="Stroke" Value="{DynamicResource NavBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="HorizontalAlignment" Value="Right" />
                <Setter Property="VerticalAlignment" Value="Top" />
                <Setter Property="Margin" Value="0,-3,-4,0" />
            </Style>

            <!--
                Кнопка-значок в панели: только контур, без рамки и подложки.
                Заметна ровно настолько, чтобы её нашли, и не спорит с задачами.
            -->
            <Style x:Key="NavIconButton" TargetType="Button">
                <Setter Property="Width" Value="34" />
                <Setter Property="Height" Value="34" />
                <Setter Property="Margin" Value="14,0,14,10" />
                <Setter Property="HorizontalAlignment" Value="Left" />
                <Setter Property="Cursor" Value="Hand" />
                <Setter Property="SnapsToDevicePixels" Value="True" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="Button">
                            <Border x:Name="Chrome"
                                    Background="Transparent"
                                    CornerRadius="7"
                                    SnapsToDevicePixels="True">
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource NavHoverBrush}" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="Chrome" Property="Background"
                                            Value="{DynamicResource NavSelectedBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <Style x:Key="NavToggleIcon" TargetType="Path">
                <Setter Property="Width" Value="18" />
                <Setter Property="Height" Value="18" />
                <Setter Property="Stretch" Value="None" />
                <Setter Property="Stroke" Value="{DynamicResource NavInkSecondaryBrush}" />
                <Setter Property="StrokeThickness" Value="1.5" />
                <Setter Property="StrokeStartLineCap" Value="Round" />
                <Setter Property="StrokeEndLineCap" Value="Round" />
                <Setter Property="StrokeLineJoin" Value="Round" />
                <Style.Triggers>
                    <DataTrigger Binding="{Binding IsMouseOver, RelativeSource={RelativeSource AncestorType=Button}}"
                                 Value="True">
                        <Setter Property="Stroke" Value="{DynamicResource NavInkBrush}" />
                    </DataTrigger>
                </Style.Triggers>
            </Style>

            <!-- «ЗАДАЧИ» над списком -->
            <Style x:Key="NavSectionText" TargetType="TextBlock" BasedOn="{StaticResource SectionLabelText}">
                <Setter Property="FontSize" Value="10.5" />
                <Setter Property="Foreground" Value="{DynamicResource NavInkFaintBrush}" />
                <Setter Property="Margin" Value="22,0,22,8" />
            </Style>

            <!-- Подписи в панели: название программы, версия, примечание внизу -->
            <Style x:Key="NavTitleText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="14" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Foreground" Value="{DynamicResource NavInkBrush}" />
                <Setter Property="TextWrapping" Value="NoWrap" />
            </Style>

            <Style x:Key="NavFaintText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource NavInkFaintBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <!-- Строка списка замечаний -->
            <Style x:Key="WarningText" TargetType="TextBlock">
                <Setter Property="FontSize" Value="13" />
                <Setter Property="LineHeight" Value="18" />
                <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
                <Setter Property="TextWrapping" Value="Wrap" />
            </Style>

            <Style x:Key="WarningWhereText" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                <Setter Property="FontSize" Value="11" />
                <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                <Setter Property="Margin" Value="0,2,0,0" />
            </Style>

        </ResourceDictionary>
    </Application.Resources>
</Application>

<Window x:Class="WarehousePlanAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формирование плана склада"
        Icon="Assets/app.ico"
        Height="640" Width="820" MinHeight="560" MinWidth="720"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource GroundBrush}"
        FontFamily="Segoe UI"
        FontSize="13"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            Плитка «осталось вручную». Это единственный счётчик, который требует действия,
            поэтому при значении больше нуля она меняет цвет, а не просто показывает число.
        -->
        <Style x:Key="LeftoverTile" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLeftovers}" Value="True">
                    <Setter Property="Background" Value="{StaticResource WarnSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{StaticResource WarnBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,8" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeftoverCounter" TargetType="TextBlock" BasedOn="{StaticResource CounterText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLeftovers}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="LeftoverCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasLeftovers}" Value="True">
                    <Setter Property="Foreground" Value="{StaticResource WarnInkBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Поле пути: подсвечивается, пока файл держат над окном -->
        <Style x:Key="DropTargetPathBox" TargetType="TextBox" BasedOn="{StaticResource PathTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}" />
                    <Setter Property="Background" Value="#EFEFF7" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Путь к результату: только для чтения, но выделяется и копируется -->
        <Style x:Key="ResultPathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Foreground" Value="{StaticResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </Window.Resources>

    <Grid Margin="26,24,26,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Заголовок ================= -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="Формирование плана склада" />
            <TextBlock Margin="0,5,0,0" Text="{Binding StatusMessage}">
                <!--
                    Строка состояния прячется там, где её текст уже показан рядом:
                    во время обработки - под полосой прогресса, после успеха - в карточке
                    результата. Иначе одна и та же фраза стоит в окне дважды.
                -->
                <TextBlock.Style>
                    <Style TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
                        <Style.Triggers>
                            <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding HasResult}" Value="True">
                                <Setter Property="Visibility" Value="Collapsed" />
                            </DataTrigger>
                        </Style.Triggers>
                    </Style>
                </TextBlock.Style>
            </TextBlock>
        </StackPanel>

        <!-- ================= Файл ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,18,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabelText}" Text="ФАЙЛ" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox Grid.Column="0"
                             Style="{StaticResource DropTargetPathBox}"
                             Text="{Binding SelectedFilePath, Mode=OneWay}"
                             ToolTip="{Binding SelectedFilePath}" />

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Margin="10,0,0,0"
                            MinWidth="120"
                            Content="Выбрать файл"
                            Command="{Binding SelectFileCommand}" />
                </Grid>
                <TextBlock Style="{StaticResource CaptionText}"
                           Margin="0,8,0,0"
                           Text="Книгу можно перетащить прямо в это окно." />
            </StackPanel>
        </Border>

        <!-- ================= Запуск ================= -->
        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,16,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="Сформировать план склада"
                    Command="{Binding ProcessCommand}" />
            <Button Style="{StaticResource SecondaryButton}"
                    Height="38"
                    Margin="10,0,0,0"
                    MinWidth="96"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ================= Ход обработки ================= -->
        <StackPanel Grid.Row="3"
                    Margin="0,16,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Style="{StaticResource SlimProgressBar}"
                         Value="{Binding ProgressValue, Mode=OneWay}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Foreground="{StaticResource InkSecondaryBrush}"
                           Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource AccentBrush}"
                           Text="{Binding ProgressValue, StringFormat={}{0} %}" />
            </Grid>
        </StackPanel>

        <!-- ================= Результат / ошибка / подсказка ================= -->
        <Grid Grid.Row="4" Margin="0,16,0,0">

            <!-- Подсказка, пока показывать нечего -->
            <TextBlock HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Foreground="{StaticResource InkFaintBrush}"
                       Text="Результат появится здесь"
                       Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}" />

            <!-- Ошибка -->
            <Border Style="{StaticResource Card}"
                    VerticalAlignment="Top"
                    Background="{StaticResource ErrorSoftBrush}"
                    BorderBrush="{StaticResource ErrorBorderBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.6"
                                 Width="18" Height="18" />
                        <Path Data="M9,5.2 L9,10.4"
                              Stroke="{StaticResource ErrorBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,-3,0,0" />
                        <Ellipse Fill="{StaticResource ErrorBrush}" Width="1.9" Height="1.9"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="0,7,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{StaticResource ErrorBrush}"
                               MaxWidth="620"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Результат -->
            <!--
                Карточка прижата к верху и растёт по содержимому: если растянуть её
                на всю высоту окна, кнопка отрывается от текста и повисает внизу.
            -->
            <Border Style="{StaticResource Card}"
                    VerticalAlignment="Top"
                    BorderBrush="{StaticResource SuccessBorderBrush}"
                    Padding="16,15"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Шапка -->
                    <StackPanel Grid.Row="0" Orientation="Horizontal">
                        <Border Width="22" Height="22" CornerRadius="11"
                                Background="{StaticResource SuccessSoftBrush}"
                                VerticalAlignment="Center">
                            <Path Data="M3.2,7.3 L5.8,9.9 L10.9,4.2"
                                  Stroke="{StaticResource SuccessBrush}"
                                  StrokeThickness="2"
                                  StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  StrokeLineJoin="Round"
                                  HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <TextBlock Margin="9,0,0,0"
                                   FontSize="14" FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Text="План склада успешно сформирован" />
                    </StackPanel>

                    <!-- Счётчики -->
                    <Grid Grid.Row="1" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource Tile}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CounterText}"
                                           Text="{Binding ProcessedRows}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"
                                           Text="обработано строк" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="1" Style="{StaticResource LeftoverTile}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource LeftoverCounter}"
                                           Text="{Binding RemainingRows}" />
                                <TextBlock Style="{StaticResource LeftoverCaption}"
                                           Margin="0,2,0,0"
                                           Text="осталось вручную" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Tile}" Margin="0,0,10,0">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CounterText}"
                                           Text="{Binding NewOrders}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"
                                           Text="новых заказов" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="3" Style="{StaticResource Tile}">
                            <StackPanel>
                                <TextBlock Style="{StaticResource CounterText}"
                                           Text="{Binding DeletedPlaceholders}" />
                                <TextBlock Style="{StaticResource CaptionText}"
                                           Margin="0,2,0,0"
                                           Text="удалено заглушек" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Пояснение под счётчиками -->
                    <Grid Grid.Row="2" Margin="0,12,0,0">
                        <TextBlock Text="Все строки выгрузки распределились автоматически.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="FontSize" Value="12" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasLeftovers}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Orientation="Horizontal"
                                    Visibility="{Binding HasLeftovers, Converter={StaticResource BoolToVisibility}}">
                            <Grid Width="15" Height="15" VerticalAlignment="Top" Margin="0,1,7,0">
                                <Ellipse Stroke="{StaticResource WarnBrush}" StrokeThickness="1.4"
                                         Width="15" Height="15" />
                                <Path Data="M7.5,4 L7.5,8.4"
                                      Stroke="{StaticResource WarnBrush}" StrokeThickness="1.6"
                                      StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                      HorizontalAlignment="Center" VerticalAlignment="Center"
                                      Margin="0,-2,0,0" />
                                <Ellipse Fill="{StaticResource WarnBrush}" Width="1.7" Height="1.7"
                                         HorizontalAlignment="Center" VerticalAlignment="Center"
                                         Margin="0,5,0,0" />
                            </Grid>
                            <TextBlock FontSize="12"
                                       MaxWidth="600"
                                       Foreground="{StaticResource WarnInkBrush}"
                                       Text="Эти строки не подошли ни под одно правило и остались на листе «Заказы на отгрузку» — их нужно разобрать вручную." />
                        </StackPanel>
                    </Grid>

                    <!-- Путь к результату -->
                    <StackPanel Grid.Row="3" Margin="0,14,0,0">
                        <TextBlock Style="{StaticResource CaptionText}" Text="Файл результата" />
                        <TextBox Style="{StaticResource ResultPathBox}"
                                 Margin="0,3,0,0"
                                 Text="{Binding ResultPath, Mode=OneWay}" />
                    </StackPanel>

                    <!-- Действие -->
                    <Button Grid.Row="4"
                            Style="{StaticResource SecondaryButton}"
                            HorizontalAlignment="Left"
                            Height="32"
                            Margin="0,16,0,0"
                            Command="{Binding OpenResultFolderCommand}">
                        <StackPanel Orientation="Horizontal">
                            <Path Data="M1,3 L5.5,3 L7,5 L14,5 L14,13 L1,13 Z"
                                  Stroke="{StaticResource InkSecondaryBrush}"
                                  StrokeThickness="1.4"
                                  StrokeLineJoin="Round"
                                  Width="15" Height="14"
                                  VerticalAlignment="Center"
                                  Margin="0,0,8,0" />
                            <TextBlock Text="Открыть папку с результатом" VerticalAlignment="Center" />
                        </StackPanel>
                    </Button>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>

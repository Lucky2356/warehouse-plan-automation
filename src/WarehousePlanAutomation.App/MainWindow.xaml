<Window x:Class="WarehousePlanAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Формирование плана склада"
        Height="440" Width="760" MinHeight="400" MinWidth="640"
        WindowStartupLocation="CenterScreen">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </Window.Resources>

    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Выбор файла -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <TextBlock Grid.Column="0"
                       Text="Файл:"
                       VerticalAlignment="Center"
                       Margin="0,0,8,0" />

            <TextBox Grid.Column="1"
                     Text="{Binding SelectedFilePath, Mode=OneWay}"
                     IsReadOnly="True"
                     VerticalContentAlignment="Center"
                     Padding="6,4"
                     ToolTip="{Binding SelectedFilePath}" />

            <Button Grid.Column="2"
                    Content="Выбрать файл"
                    Margin="8,0,0,0"
                    Command="{Binding SelectFileCommand}" />
        </Grid>

        <!-- Запуск -->
        <Button Grid.Row="1"
                Content="Сформировать план склада"
                HorizontalAlignment="Left"
                Margin="0,16,0,0"
                Padding="20,8"
                FontWeight="SemiBold"
                Command="{Binding ProcessCommand}" />

        <!-- Состояние -->
        <TextBlock Grid.Row="2"
                   Margin="0,16,0,0"
                   Text="{Binding StatusMessage}" />

        <ProgressBar Grid.Row="3"
                     Height="16"
                     Margin="0,8,0,0"
                     Minimum="0"
                     Maximum="100"
                     Value="{Binding ProgressValue, Mode=OneWay}"
                     Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />

        <!-- Ошибка -->
        <Border Grid.Row="4"
                Margin="0,12,0,0"
                Padding="10"
                Background="#FFF4F4"
                BorderBrush="#E0A0A0"
                BorderThickness="1"
                Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
            <TextBlock Text="{Binding ErrorMessage}" Foreground="#A00000" />
        </Border>

        <!-- Результат -->
        <Border Grid.Row="5"
                Margin="0,12,0,0"
                Padding="12"
                VerticalAlignment="Top"
                Background="#F3F8F3"
                BorderBrush="#A8C8A8"
                BorderThickness="1"
                Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
            <StackPanel>
                <TextBlock Text="План склада успешно сформирован"
                           FontWeight="SemiBold"
                           Margin="0,0,0,8" />

                <TextBlock Text="Файл результата:" Margin="0,0,0,2" />
                <TextBox Text="{Binding ResultPath, Mode=OneWay}"
                         IsReadOnly="True"
                         BorderThickness="0"
                         Background="Transparent"
                         TextWrapping="Wrap"
                         Margin="0,0,0,8" />

                <TextBlock Text="{Binding ResultSummary}" Margin="0,0,0,10" />

                <Button Content="Открыть папку с результатом"
                        HorizontalAlignment="Left"
                        Command="{Binding OpenResultFolderCommand}" />
            </StackPanel>
        </Border>
    </Grid>
</Window>

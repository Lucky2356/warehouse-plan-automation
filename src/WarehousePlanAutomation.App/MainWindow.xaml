<Window x:Class="WarehousePlanAutomation.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:WarehousePlanAutomation.App.ViewModels"
        xmlns:views="clr-namespace:WarehousePlanAutomation.App.Views"
        Title="Формирование отчётов"
        Icon="Assets/app.ico"
        Height="760" Width="1180" MinHeight="600" MinWidth="900"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource GroundBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13.5"
        AllowDrop="True"
        DragOver="OnDragOver"
        DragLeave="OnDragLeave"
        Drop="OnDrop"
        SizeChanged="OnSizeChanged"
        TextOptions.TextFormattingMode="Display">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Любая задача рисуется одним и тем же экраном -->
        <DataTemplate DataType="{x:Type vm:WorkbookTaskViewModel}">
            <views:WorkbookTaskView />
        </DataTemplate>

        <DataTemplate DataType="{x:Type vm:UpdatesViewModel}">
            <views:UpdatesView />
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Ширину задаёт сама панель: узкое окно - только значки -->
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ================= Боковая панель ================= -->
        <!--
            Список задач виден всегда, поэтому кнопка «Назад» не нужна:
            переход между задачами - один щелчок из любого места.
        -->
        <Border Grid.Column="0"
                Background="{DynamicResource NavBrush}"
                BorderBrush="{DynamicResource NavBorderBrush}"
                BorderThickness="0,0,1,0">
            <Border.Style>
                <Style TargetType="Border">
                    <Setter Property="Width" Value="232" />
                    <Style.Triggers>
                        <!--
                            64 - не круглое число, а посчитанное: при отступах пункта 10
                            и внутренних 12 значок шириной 20 встаёт ровно по центру.
                        -->
                        <DataTrigger Binding="{Binding IsCompact}" Value="True">
                            <Setter Property="Width" Value="64" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </Border.Style>
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Имя приложения и версия -->
                <StackPanel Grid.Row="0" Orientation="Horizontal">
                    <StackPanel.Style>
                        <Style TargetType="StackPanel">
                            <Setter Property="Margin" Value="20,22,16,20" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Margin" Value="17,22,17,20" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </StackPanel.Style>

                    <Border Width="30" Height="30" CornerRadius="8"
                            Background="{DynamicResource NavMarkBrush}"
                            VerticalAlignment="Center">
                        <!-- Три столбика: отчёт по товарным запасам -->
                        <Canvas Width="16" Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Rectangle Canvas.Left="0" Canvas.Top="8"
                                       Width="3.6" Height="8" RadiusX="1.2" RadiusY="1.2"
                                       Fill="#FFFFFF" Opacity="0.66" />
                            <Rectangle Canvas.Left="5.7" Canvas.Top="4"
                                       Width="3.6" Height="12" RadiusX="1.2" RadiusY="1.2"
                                       Fill="#FFFFFF" />
                            <Rectangle Canvas.Left="11.4" Canvas.Top="0"
                                       Width="3.6" Height="16" RadiusX="1.2" RadiusY="1.2"
                                       Fill="#FFFFFF" Opacity="0.66" />
                        </Canvas>
                    </Border>

                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Style="{StaticResource NavTitleText}" Text="Отчёты" />
                        <TextBlock Style="{StaticResource NavFaintText}"
                                   TextWrapping="NoWrap"
                                   Text="{Binding Version}" />
                    </StackPanel>
                </StackPanel>

                <TextBlock Grid.Row="1" Text="ЗАДАЧИ">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NavSectionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <ListBox Grid.Row="2"
                         Style="{StaticResource NavList}"
                         ItemsSource="{Binding Pages}"
                         SelectedItem="{Binding SelectedPage}">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <Grid ToolTip="{Binding Subtitle}">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <!-- Значок остаётся при любой ширине: по нему и узнают задачу -->
                                <Grid Grid.Column="0">
                                    <Path Style="{StaticResource NavItemIcon}"
                                          Data="{Binding IconData}" />

                                    <!-- На свёрнутой панели новость показывает точка -->
                                    <Ellipse>
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse" BasedOn="{StaticResource NavBadgeDot}">
                                                <Setter Property="Visibility" Value="Collapsed" />
                                                <Style.Triggers>
                                                    <MultiDataTrigger>
                                                        <MultiDataTrigger.Conditions>
                                                            <Condition Binding="{Binding HasBadge}" Value="True" />
                                                            <Condition Binding="{Binding DataContext.IsCompact,
                                                                        RelativeSource={RelativeSource AncestorType=Window}}"
                                                                       Value="True" />
                                                        </MultiDataTrigger.Conditions>
                                                        <Setter Property="Visibility" Value="Visible" />
                                                    </MultiDataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>

                                <TextBlock Grid.Column="1"
                                           Margin="10,0,0,0"
                                           Text="{Binding Title}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource NavItemText}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding DataContext.IsCompact,
                                                             RelativeSource={RelativeSource AncestorType=Window}}"
                                                             Value="True">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>

                                <!-- Значок «новое»: обновление видно и с другой страницы -->
                                <Border Grid.Column="2">
                                    <Border.Style>
                                        <Style TargetType="Border" BasedOn="{StaticResource NavBadge}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding HasBadge}" Value="True" />
                                                        <Condition Binding="{Binding DataContext.IsCompact,
                                                                    RelativeSource={RelativeSource AncestorType=Window}}"
                                                                   Value="False" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <TextBlock Style="{StaticResource NavBadgeText}"
                                               Text="{Binding Badge}" />
                                </Border>
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!--
                    Переключатель темы. Стоит внизу панели рядом с примечанием: им
                    пользуются один раз, поэтому он не должен занимать место наверху,
                    но и прятать его в меню не за чем - меню в окне нет.
                -->
                <Button Grid.Row="3"
                        Style="{StaticResource NavIconButton}"
                        AutomationProperties.Name="Тема оформления"
                        Command="{Binding ToggleThemeCommand}"
                        ToolTip="{Binding ThemeHint}">
                    <Grid Width="18" Height="18">
                        <!-- Солнце: предложение вернуться к светлой -->
                        <Path Style="{StaticResource NavToggleIcon}"
                              Data="M9,3.4 L9,1.6 M9,16.4 L9,14.6 M14.6,9 L16.4,9 M1.6,9 L3.4,9 M12.95,5.05 L14.22,3.78 M3.78,14.22 L5.05,12.95 M12.95,12.95 L14.22,14.22 M3.78,3.78 L5.05,5.05 M12.2,9 A3.2,3.2 0 1,1 5.8,9 A3.2,3.2 0 1,1 12.2,9"
                              Visibility="{Binding IsDarkTheme, Converter={StaticResource BoolToVisibility}}" />

                        <!-- Месяц: предложение перейти в тёмную -->
                        <Path Data="M15,11.3 A6.6,6.6 0 1,1 6.7,3 A5.3,5.3 0 0,0 15,11.3">
                            <Path.Style>
                                <Style TargetType="Path" BasedOn="{StaticResource NavToggleIcon}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDarkTheme}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Path.Style>
                        </Path>
                    </Grid>
                </Button>

                <TextBlock Grid.Row="4"
                           Text="Исходный файл не изменяется: результат сохраняется рядом отдельной книгой.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource NavFaintText}">
                            <Setter Property="Margin" Value="20,0,20,18" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsCompact}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- ================= Выбранная страница ================= -->
        <!--
            Ширина содержимого ограничена: на широком мониторе строка замечания через
            весь экран нечитаема, а карточки, растянутые на 2000 px, выглядят пустыми.
        -->
        <Grid Grid.Column="1">
            <Grid.ColumnDefinitions>
                <!-- Занимает всё, что осталось, но не шире 1060: дальше только поле -->
                <ColumnDefinition Width="*" MaxWidth="1060" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <ContentControl Grid.Column="0"
                            Content="{Binding SelectedPage}"
                            Focusable="False" />
        </Grid>
    </Grid>
</Window>

<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <RootNamespace>WarehousePlanAutomation.App</RootNamespace>
    <AssemblyName>WarehousePlanAutomation</AssemblyName>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>

    <!--
      Публикация в один исполняемый файл: пользователь скачивает и запускает единственный .exe.
      BuiltInComInteropSupport обязателен: в режиме одного файла встроенная поддержка COM
      по умолчанию отключается, и позднее связывание с Excel.Application перестаёт работать
      с ошибкой «System.__ComObject does not contain a definition for ...».
      Обрезка (PublishTrimmed) недопустима: позднее связывание не поддаётся статическому анализу.
    -->
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <BuiltInComInteropSupport>true</BuiltInComInteropSupport>
    <PublishTrimmed>false</PublishTrimmed>
    <PublishReadyToRun>false</PublishReadyToRun>
  </PropertyGroup>

  <ItemGroup>
    <!--
      ApplicationIcon задаёт иконку самого .exe. Чтобы её же показывал заголовок окна
      (Icon= у Window), файл должен попасть в сборку ресурсом: для .ico это не делается
      автоматически, в отличие от .png.
    -->
    <Resource Include="Assets\app.ico" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\WarehousePlanAutomation.Core\WarehousePlanAutomation.Core.csproj" />
    <ProjectReference Include="..\WarehousePlanAutomation.Excel\WarehousePlanAutomation.Excel.csproj" />
  </ItemGroup>

</Project>

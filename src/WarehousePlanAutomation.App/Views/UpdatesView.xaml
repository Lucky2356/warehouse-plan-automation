<UserControl x:Class="WarehousePlanAutomation.App.Views.UpdatesView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource InkBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13.5">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!-- Сообщение о неудаче отличается цветом: это не рядовое состояние -->
        <Style x:Key="StatusText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HasProblem}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <Grid Margin="32,26,32,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- ================= Заголовок ================= -->
        <StackPanel Grid.Row="0">
            <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
            <TextBlock Style="{StaticResource SubtitleText}"
                       Margin="0,5,0,0"
                       Text="Программа проверяет их сама при каждом запуске." />
        </StackPanel>

        <!-- ================= Состояние ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Тот же значок, что и в боковой панели: страница узнаётся сразу -->
                <Border Grid.Column="0"
                        Width="38" Height="38"
                        CornerRadius="10"
                        Background="{DynamicResource AccentSoftBrush}"
                        VerticalAlignment="Top"
                        Margin="0,0,14,0">
                    <Path Data="M10,3.4 L10,11.8 M6.6,8.6 L10,12 L13.4,8.6 M4,14.2 L4,15.6 A1.4,1.4 0 0,0 5.4,17 L14.6,17 A1.4,1.4 0 0,0 16,15.6 L16,14.2"
                          Stroke="{DynamicResource AccentBrush}"
                          StrokeThickness="1.7"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="20" Height="20" Stretch="None"
                          HorizontalAlignment="Center" VerticalAlignment="Center" />
                </Border>

                <StackPanel Grid.Column="1">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Style="{StaticResource StatusText}"
                                   VerticalAlignment="Center"
                                   Text="{Binding StatusMessage}" />
                        <Border Style="{StaticResource Pill}"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}">
                            <TextBlock Style="{StaticResource PillText}" Text="готова к установке" />
                        </Border>
                    </StackPanel>

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,5,0,0"
                               Typography.NumeralAlignment="Tabular"
                               Text="{Binding Details}"
                               Visibility="{Binding HasDetails, Converter={StaticResource BoolToVisibility}}" />

                    <ProgressBar Style="{StaticResource SlimProgressBar}"
                                 Margin="0,13,0,0"
                                 Value="{Binding ProgressValue, Mode=OneWay}"
                                 Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />

                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,9,0,0"
                               Text="Обновление скачивается в фоне: работать с книгами можно как обычно."
                               Visibility="{Binding IsDownloading, Converter={StaticResource BoolToVisibility}}" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ================= Что нового ================= -->
        <Border Grid.Row="2"
                Style="{StaticResource Card}"
                Margin="0,14,0,0"
                Visibility="{Binding HasNotes, Converter={StaticResource BoolToVisibility}}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Style="{StaticResource SectionLabelText}" Text="ЧТО НОВОГО" />

                <!-- Описание выпуска пишет человек: оно может быть и в три строки, и в тридцать -->
                <ScrollViewer Grid.Row="1"
                              Margin="0,10,0,0"
                              MaxHeight="300"
                              VerticalScrollBarVisibility="Auto">
                    <TextBlock Style="{StaticResource WarningText}" Text="{Binding Notes}" />
                </ScrollViewer>
            </Grid>
        </Border>

        <!-- ================= Действия ================= -->
        <Grid Grid.Row="4" Margin="0,18,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <Button Style="{StaticResource PrimaryButton}"
                        Margin="0,0,10,0"
                        Content="Установить и перезапустить"
                        Command="{Binding InstallCommand}"
                        Visibility="{Binding IsReady, Converter={StaticResource BoolToVisibility}}" />

                <Button Style="{StaticResource SecondaryButton}"
                        VerticalAlignment="Center"
                        Content="Проверить ещё раз"
                        Command="{Binding CheckCommand}" />

                <Button Style="{StaticResource SecondaryButton}"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center"
                        Content="Открыть на GitHub"
                        Command="{Binding OpenPageCommand}" />
            </StackPanel>

            <TextBlock Grid.Column="1"
                       Style="{StaticResource CaptionText}"
                       VerticalAlignment="Center"
                       Margin="12,0,0,0"
                       Text="{Binding CurrentVersion, StringFormat=Установлена версия {0}}" />
        </Grid>
    </Grid>
</UserControl>

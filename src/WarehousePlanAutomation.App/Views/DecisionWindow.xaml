<Window x:Class="WarehousePlanAutomation.App.Views.DecisionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Нужен ваш выбор"
        SizeToContent="Height"
        Width="520"
        MaxHeight="620"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        Background="{DynamicResource GroundBrush}"
        Foreground="{DynamicResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="13.5"
        TextOptions.TextFormattingMode="Display">

    <Border Style="{StaticResource Card}" Margin="18" Padding="20,18">
        <StackPanel>
            <TextBlock x:Name="QuestionText"
                       FontSize="15"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap" />

            <TextBlock x:Name="ExplanationText"
                       Style="{StaticResource SubtitleText}"
                       Margin="0,7,0,0" />

            <!-- Вариантов может быть много: список прокручивается -->
            <ListBox x:Name="OptionsList"
                     Style="{StaticResource OptionList}"
                     Margin="0,16,0,0"
                     MaxHeight="220"
                     MouseDoubleClick="OnOptionDoubleClick">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <TextBlock Style="{StaticResource OptionText}" Text="{Binding}" />
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <StackPanel Orientation="Horizontal"
                        HorizontalAlignment="Right"
                        Margin="0,18,0,0">
                <Button Style="{StaticResource SecondaryButton}"
                        MinWidth="120"
                        Content="Пропустить"
                        Click="OnSkip" />
                <Button x:Name="ConfirmButton"
                        Style="{StaticResource PrimaryButton}"
                        Height="34"
                        Margin="10,0,0,0"
                        MinWidth="120"
                        Content="Выбрать"
                        IsDefault="True"
                        Click="OnConfirm" />
            </StackPanel>

            <TextBlock Style="{StaticResource CaptionText}"
                       Margin="0,10,0,0"
                       HorizontalAlignment="Right"
                       Text="«Пропустить» — оставить ячейки пустыми и записать замечание." />
        </StackPanel>
    </Border>
</Window>

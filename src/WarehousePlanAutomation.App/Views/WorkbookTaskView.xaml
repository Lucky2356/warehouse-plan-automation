<UserControl x:Class="WarehousePlanAutomation.App.Views.WorkbookTaskView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Foreground="{DynamicResource InkBrush}"
             FontFamily="Segoe UI Variable Text, Segoe UI"
             FontSize="13.5"
             TextOptions.TextFormattingMode="Display">

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--
            Плитка счётчика. Счётчик, помеченный как требующий действия, меняет цвет,
            а не просто показывает число: остальные числа смотреть не обязательно.
        -->
        <Style x:Key="CounterTile" TargetType="Border" BasedOn="{StaticResource Tile}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
                    <Setter Property="BorderBrush" Value="{DynamicResource WarnBorderBrush}" />
                    <Setter Property="BorderThickness" Value="1" />
                    <Setter Property="Padding" Value="10,9" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style x:Key="TileCounter" TargetType="TextBlock" BasedOn="{StaticResource CounterText}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Подпись плитки переносится на вторую строку: «строк с местом хранения» в одну не лезет -->
        <Style x:Key="TileCaption" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="TextWrapping" Value="Wrap" />
            <Setter Property="MaxHeight" Value="32" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding NeedsAttention}" Value="True">
                    <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                    <Setter Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Поле пути: подсвечивается, пока файл держат над окном -->
        <Style x:Key="DropTargetPathBox" TargetType="TextBox" BasedOn="{StaticResource PathTextBox}">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsDragOver}" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                    <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Путь к результату: только для чтения, но выделяется и копируется -->
        <Style x:Key="ResultPathBox" TargetType="TextBox">
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="Foreground" Value="{DynamicResource InkBrush}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--
            Строка замечания целиком кликабельна: щелчок открывает готовую книгу
            на той самой ячейке. Там, где адреса нет, команда отключена - строка
            просто не подсвечивается и на нажатие не отзывается.
        -->
        <Style x:Key="WarningRow" TargetType="Button">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="SnapsToDevicePixels" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Chrome"
                                Background="Transparent"
                                BorderBrush="{DynamicResource HairlineBrush}"
                                BorderThickness="0,1,0,0"
                                Padding="8,9"
                                SnapsToDevicePixels="True">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="Background"
                                        Value="{DynamicResource TileBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Cursor" Value="Arrow" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Значок «перейти»: виден только у тех замечаний, куда действительно можно перейти -->
        <Style x:Key="GoHint" TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Margin" Value="12,0,0,0" />
            <Setter Property="Visibility" Value="Collapsed" />
            <Style.Triggers>
                <MultiDataTrigger>
                    <MultiDataTrigger.Conditions>
                        <Condition Binding="{Binding CanNavigate}" Value="True" />
                        <Condition Binding="{Binding IsMouseOver,
                                    RelativeSource={RelativeSource AncestorType=Button}}" Value="True" />
                    </MultiDataTrigger.Conditions>
                    <Setter Property="Visibility" Value="Visible" />
                </MultiDataTrigger>
            </Style.Triggers>
        </Style>
    </UserControl.Resources>

    <!--
        Прокручивается вся страница целиком, а не одна карточка результата: в невысоком
        окне до замечаний иначе не добраться, а колесо над карточкой ничего не двигало бы.
    -->
    <ScrollViewer x:Name="PageScroll"
                  VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled"
                  Focusable="False"
                  PanningMode="VerticalOnly"
                  Padding="30,28,26,26">
    <!--
        Страница не ниже окна: пустое место результата занимает всю оставшуюся высоту,
        а когда результат длинный - страница просто прокручивается.
    -->
    <Grid MinHeight="{Binding ViewportHeight, ElementName=PageScroll}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- ================= Заголовок ================= -->
        <Grid Grid.Row="0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Style="{StaticResource TitleText}" Text="{Binding Title}" />
                <TextBlock Margin="0,4,0,0" Text="{Binding StatusMessage}">
                    <!--
                        Строка состояния прячется там, где её текст уже показан рядом:
                        во время обработки - под полосой прогресса, после успеха - меткой
                        справа. Иначе одна и та же фраза стоит в окне дважды.
                    -->
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource SubtitleText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding HasResult}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>

            <!-- Метка успеха: коротко и в цвете, чтобы не повторять фразу дважды -->
            <Border Grid.Column="1"
                    Style="{StaticResource Pill}"
                    VerticalAlignment="Top"
                    Margin="20,4,0,0"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Path Data="M3.4,8.4 L6.4,11.4 L12.6,4.4"
                          Stroke="{DynamicResource SuccessBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round"
                          Width="16" Height="16" Stretch="None"
                          VerticalAlignment="Center" />
                    <TextBlock Style="{StaticResource PillText}"
                               Margin="7,0,0,0"
                               VerticalAlignment="Center"
                               Text="{Binding SuccessMessage}" />
                </StackPanel>
            </Border>
        </Grid>

        <!-- ================= Файл ================= -->
        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,20,0,0">
            <StackPanel>
                <TextBlock Style="{StaticResource SectionLabelText}" Text="ИСХОДНАЯ КНИГА" />
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!--
                        Подсказка с полным путём включается только тогда, когда путь есть:
                        иначе WPF показывает пустой прямоугольник у курсора.
                    -->
                    <TextBox Grid.Column="0"
                             Style="{StaticResource DropTargetPathBox}"
                             Text="{Binding SelectedFilePath, Mode=OneWay}"
                             ToolTip="{Binding SelectedFilePath}"
                             ToolTipService.IsEnabled="{Binding HasSelectedFile}"
                             PreviewMouseWheel="OnInnerListWheel"
                             AutomationProperties.Name="Путь к исходной книге" />

                    <Button Grid.Column="1"
                            Style="{StaticResource SecondaryButton}"
                            Height="36"
                            Margin="10,0,0,0"
                            MinWidth="140"
                            Content="Выбрать файл"
                            Command="{Binding SelectFileCommand}" />
                </Grid>
                <TextBlock Margin="0,8,0,0"
                           Text="Книгу можно перетащить прямо в это окно.">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding HasSelectedFile}" Value="True">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>

                <!--
                    Дополнительная папка задачи - есть не у всех задач. Выбор запоминается
                    сразу и действует на все следующие запуски, поэтому стоит рядом с книгой.
                -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding HasFolderOption, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionLabelText}" Text="{Binding FolderOptionTitle}" />
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBox Grid.Column="0"
                                 Style="{StaticResource PathTextBox}"
                                 Text="{Binding OptionFolderPath, Mode=OneWay}"
                                 ToolTip="{Binding OptionFolderPath}"
                                 ToolTipService.IsEnabled="{Binding HasOptionFolder}"
                                 PreviewMouseWheel="OnInnerListWheel"
                                 AutomationProperties.Name="{Binding FolderOptionTitle}" />

                        <Button Grid.Column="1"
                                Style="{StaticResource SecondaryButton}"
                                Height="36"
                                Margin="10,0,0,0"
                                MinWidth="140"
                                Content="Выбрать файл"
                                Command="{Binding SelectOptionFileCommand}"
                                Visibility="{Binding FolderOptionAllowsFile, Converter={StaticResource BoolToVisibility}}" />

                        <Button Grid.Column="2"
                                Style="{StaticResource SecondaryButton}"
                                Height="36"
                                Margin="8,0,0,0"
                                MinWidth="120"
                                Content="Выбрать папку"
                                Command="{Binding SelectOptionFolderCommand}" />

                        <Button Grid.Column="3"
                                Style="{StaticResource SecondaryButton}"
                                Height="36"
                                Margin="8,0,0,0"
                                MinWidth="80"
                                Content="Убрать"
                                Command="{Binding ClearOptionFolderCommand}"
                                Visibility="{Binding HasOptionFolder, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0"
                               Text="{Binding FolderOptionHint}" />
                </StackPanel>

                <!--
                    Варианты запуска - есть не у всех задач. Стоят рядом с кнопкой запуска
                    по смыслу: выбор меняет и её надпись, и то, что будет сделано.
                -->
                <StackPanel Margin="0,16,0,0"
                            Visibility="{Binding HasRunOptions, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock Style="{StaticResource SectionLabelText}" Text="{Binding RunOptionsTitle}" />
                    <ListBox Margin="0,10,0,0"
                             Style="{StaticResource OptionList}"
                             ItemsSource="{Binding RunOptions}"
                             SelectedItem="{Binding SelectedRunOption, Mode=TwoWay}"
                             IsEnabled="{Binding IsIdle}"
                             PreviewMouseWheel="OnInnerListWheel"
                             AutomationProperties.Name="{Binding RunOptionsTitle}">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Rows="1" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Style="{StaticResource OptionText}" Text="{Binding}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <TextBlock Style="{StaticResource CaptionText}"
                               Margin="0,8,0,0"
                               TextWrapping="Wrap"
                               Text="{Binding RunOptionHint}" />
                </StackPanel>
            </StackPanel>
        </Border>

        <!-- ================= Осмотр книги ================= -->
        <!--
            Показывается сразу после выбора файла, до запуска: если листа не хватает
            или сетевой файл недоступен, лучше узнать сейчас, а не через полминуты.
        -->
        <StackPanel Grid.Row="2" Margin="0,10,0,0">
            <TextBlock Style="{StaticResource CaptionText}"
                       Visibility="{Binding IsPreflightClean, Converter={StaticResource BoolToVisibility}}">
                <Run Text="✓" Foreground="{DynamicResource SuccessBrush}" FontWeight="SemiBold" />
                <Run Text=" Книга проверена: все нужные листы на месте." />
            </TextBlock>

            <ItemsControl ItemsSource="{Binding Preflight}"
                          Visibility="{Binding HasPreflight, Converter={StaticResource BoolToVisibility}}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Grid Grid.Column="0" Width="15" Height="15"
                                  VerticalAlignment="Top" Margin="0,1,8,0">
                                <Ellipse StrokeThickness="1.4" Width="15" Height="15">
                                    <Ellipse.Style>
                                        <Style TargetType="Ellipse">
                                            <Setter Property="Stroke" Value="{DynamicResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter Property="Stroke" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Ellipse.Style>
                                </Ellipse>
                                <TextBlock Text="!"
                                           FontSize="10.5"
                                           FontWeight="SemiBold"
                                           HorizontalAlignment="Center"
                                           VerticalAlignment="Center">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Foreground" Value="{DynamicResource WarnBrush}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                    <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>

                            <TextBlock Grid.Column="1" Text="{Binding Message}">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock" BasedOn="{StaticResource WarningText}">
                                        <Setter Property="FontSize" Value="12.5" />
                                        <Setter Property="Foreground" Value="{DynamicResource WarnInkBrush}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsProblem}" Value="True">
                                                <Setter Property="Foreground" Value="{DynamicResource ErrorBrush}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </StackPanel>

        <!-- ================= Запуск ================= -->
        <StackPanel Grid.Row="3" Orientation="Horizontal" Margin="0,14,0,0">
            <Button Style="{StaticResource PrimaryButton}"
                    Content="{Binding ActionCaption}"
                    Command="{Binding ProcessCommand}" />
            <Button Style="{StaticResource SecondaryButton}"
                    Height="38"
                    Margin="10,0,0,0"
                    MinWidth="96"
                    Content="Отмена"
                    Command="{Binding CancelCommand}"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}" />
        </StackPanel>

        <!-- ================= Ход обработки ================= -->
        <StackPanel Grid.Row="4"
                    Margin="0,16,0,0"
                    Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibility}}">
            <ProgressBar Style="{StaticResource SlimProgressBar}"
                         Value="{Binding ProgressValue, Mode=OneWay}" />
            <Grid Margin="0,8,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="0"
                           Foreground="{DynamicResource InkSecondaryBrush}"
                           Text="{Binding StatusMessage}" />
                <TextBlock Grid.Column="1"
                           Margin="12,0,0,0"
                           FontWeight="SemiBold"
                           Typography.NumeralAlignment="Tabular"
                           Foreground="{DynamicResource AccentBrush}"
                           Text="{Binding ProgressValue, StringFormat={}{0} %}" />
            </Grid>
        </StackPanel>

        <!-- ================= Результат / ошибка / подсказка ================= -->
        <Grid Grid.Row="5" Margin="0,16,0,0">

            <!-- Пока показывать нечего: место результата видно, но оно спокойное -->
            <Border BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    MinHeight="190"
                    Visibility="{Binding ShowHint, Converter={StaticResource BoolToVisibility}}">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <Path Data="M6.5,4.5 L25.5,4.5 L25.5,27.5 L6.5,27.5 Z M11,11.5 L21,11.5 M11,16.5 L21,16.5 M11,21.5 L17,21.5"
                          Stroke="{DynamicResource InkFaintBrush}"
                          StrokeThickness="1.4"
                          StrokeLineJoin="Round"
                          Width="32" Height="32" Stretch="None"
                          HorizontalAlignment="Center" />
                    <TextBlock Margin="0,10,0,0"
                               HorizontalAlignment="Center"
                               Foreground="{DynamicResource InkFaintBrush}"
                               Text="Результат появится здесь" />
                </StackPanel>
            </Border>

            <!-- Ошибка -->
            <Border Style="{StaticResource Card}"
                    VerticalAlignment="Top"
                    Background="{DynamicResource ErrorSoftBrush}"
                    BorderBrush="{DynamicResource ErrorBorderBrush}"
                    Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                <StackPanel Orientation="Horizontal">
                    <Grid Width="22" Height="22" VerticalAlignment="Top" Margin="0,1,10,0">
                        <Ellipse Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.6"
                                 Width="18" Height="18" />
                        <Path Data="M9,5.2 L9,10.4"
                              Stroke="{DynamicResource ErrorBrush}" StrokeThickness="1.8"
                              StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                              HorizontalAlignment="Center" VerticalAlignment="Center"
                              Margin="0,-3,0,0" />
                        <Ellipse Fill="{DynamicResource ErrorBrush}" Width="1.9" Height="1.9"
                                 HorizontalAlignment="Center" VerticalAlignment="Center"
                                 Margin="0,7,0,0" />
                    </Grid>
                    <TextBlock Text="{Binding ErrorMessage}"
                               Foreground="{DynamicResource ErrorBrush}"
                               MaxWidth="620"
                               VerticalAlignment="Center" />
                </StackPanel>
            </Border>

            <!-- Результат -->
            <!--
                Карточка прижата к верху и растёт по содержимому: если растянуть её
                на всю высоту окна, замечания оторвутся от чисел и повиснут внизу.
            -->
            <Border VerticalAlignment="Top"
                    Background="{DynamicResource CardBrush}"
                    BorderBrush="{DynamicResource CardBorderBrush}"
                    BorderThickness="1"
                    CornerRadius="10"
                    SnapsToDevicePixels="True"
                    Visibility="{Binding HasResult, Converter={StaticResource BoolToVisibility}}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Шапка: имя готового файла и переход в папку -->
                    <Border Grid.Row="0"
                            Background="{DynamicResource SuccessStripBrush}"
                            BorderBrush="{DynamicResource CardBorderBrush}"
                            BorderThickness="0,0,0,1"
                            CornerRadius="9,9,0,0"
                            Padding="16,13">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Style="{StaticResource SectionLabelText}" Text="РЕЗУЛЬТАТ" />
                                <TextBox Style="{StaticResource ResultPathBox}"
                                         Margin="0,3,0,0"
                                         Text="{Binding ResultPath, Mode=OneWay}"
                                         PreviewMouseWheel="OnInnerListWheel"
                                         AutomationProperties.Name="Путь к готовой книге" />
                            </StackPanel>

                            <!--
                                Открыть книгу - самое частое следующее действие, поэтому
                                кнопка акцентная и стоит первой. Папка нужна реже.
                            -->
                            <StackPanel Grid.Column="1"
                                        Orientation="Horizontal"
                                        Margin="14,0,0,0"
                                        VerticalAlignment="Center">
                                <Button Style="{StaticResource PrimaryButton}"
                                        Height="34"
                                        Padding="16,0"
                                        Command="{Binding OpenInExcelCommand}"
                                        ToolTip="{Binding ResultPath}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M2.5,2.5 L11.5,2.5 L11.5,15.5 L2.5,15.5 Z M2.5,6.5 L11.5,6.5 M5.2,9 L8.8,13 M8.8,9 L5.2,13"
                                              Stroke="{DynamicResource OnAccentBrush}"
                                              StrokeThickness="1.5"
                                              StrokeLineJoin="Round"
                                              Width="14" Height="18" Stretch="None"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                        <TextBlock Text="Открыть в Excel"
                                                   Foreground="{DynamicResource OnAccentBrush}"
                                                   VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>

                                <Button Style="{StaticResource SecondaryButton}"
                                        Height="34"
                                        Margin="8,0,0,0"
                                        Command="{Binding OpenResultFolderCommand}">
                                    <StackPanel Orientation="Horizontal">
                                        <Path Data="M1,3 L5.5,3 L7,5 L14,5 L14,13 L1,13 Z"
                                              Stroke="{DynamicResource InkSecondaryBrush}"
                                              StrokeThickness="1.4"
                                              StrokeLineJoin="Round"
                                              Width="15" Height="14" Stretch="None"
                                              VerticalAlignment="Center"
                                              Margin="0,0,8,0" />
                                        <TextBlock Text="Папка" VerticalAlignment="Center" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--
                        Счётчики. Плитки одинаковой ширины и переносятся на вторую строку:
                        их число зависит от задачи, а ширина окна - от экрана.
                    -->
                    <ItemsControl Grid.Row="1" Margin="16,14,10,0" ItemsSource="{Binding Counters}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel ItemWidth="170" ItemHeight="88" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Style="{StaticResource CounterTile}" Margin="0,0,8,8">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource TileCounter}"
                                                   Text="{Binding Value}" />
                                        <TextBlock Style="{StaticResource TileCaption}"
                                                   Margin="0,2,0,0"
                                                   Text="{Binding Caption}"
                                                   ToolTip="{Binding Caption}" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Замечания -->
                    <Grid Grid.Row="2" Margin="16,4,16,16">
                        <TextBlock Text="Замечаний нет: программа разобрала всё сама.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock" BasedOn="{StaticResource CaptionText}">
                                    <Setter Property="Margin" Value="0,6,0,0" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding HasWarnings}" Value="True">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <StackPanel Visibility="{Binding HasWarnings, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal" Margin="0,4,0,4">
                                <TextBlock Style="{StaticResource SectionLabelText}"
                                           VerticalAlignment="Center"
                                           Text="ЧТО ПРОВЕРИТЬ РУКАМИ" />
                                <Border Style="{StaticResource CountBadge}"
                                        Margin="8,0,0,0"
                                        VerticalAlignment="Center">
                                    <TextBlock Style="{StaticResource CountBadgeText}"
                                               Text="{Binding Warnings.Count}" />
                                </Border>
                            </StackPanel>

                            <ItemsControl ItemsSource="{Binding Warnings}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Button Style="{StaticResource WarningRow}"
                                                Command="{Binding DataContext.OpenWarningCommand,
                                                          RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                                CommandParameter="{Binding}"
                                                ToolTip="Открыть книгу на этом месте">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>

                                                <Grid Grid.Column="0" Width="16" Height="16"
                                                      VerticalAlignment="Top" Margin="0,1,10,0">
                                                    <Ellipse Stroke="{DynamicResource WarnBrush}"
                                                             StrokeThickness="1.4"
                                                             Width="15" Height="15" />
                                                    <Path Data="M7.5,4 L7.5,8.4"
                                                          Stroke="{DynamicResource WarnBrush}"
                                                          StrokeThickness="1.6"
                                                          StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                                          HorizontalAlignment="Center" VerticalAlignment="Center"
                                                          Margin="0,-2,0,0" />
                                                    <Ellipse Fill="{DynamicResource WarnBrush}"
                                                             Width="1.7" Height="1.7"
                                                             HorizontalAlignment="Center" VerticalAlignment="Center"
                                                             Margin="0,5,0,0" />
                                                </Grid>

                                                <StackPanel Grid.Column="1">
                                                    <TextBlock Style="{StaticResource WarningText}"
                                                               Text="{Binding Message}" />
                                                    <TextBlock Text="{Binding Where}">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock"
                                                                   BasedOn="{StaticResource WarningWhereText}">
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding Where}" Value="{x:Null}">
                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>

                                                <TextBlock Grid.Column="2"
                                                           Style="{StaticResource GoHint}"
                                                           Text="открыть →" />
                                            </Grid>
                                        </Button>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock Style="{StaticResource CaptionText}"
                                       Margin="8,8,0,0"
                                       Text="Щёлкните по замечанию - книга откроется на этой ячейке."
                                       Visibility="{Binding HasNavigableWarnings,
                                                    Converter={StaticResource BoolToVisibility}}" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
    </ScrollViewer>
</UserControl>
